<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시연 급식 예약"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="현재 시각을 기준으로 3회의 짧은 시연 예약을 만듭니다. 각 회차의 시간·사료량·약 A/B 개수를 직접 설정할 수 있습니다."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round_orange_soft"
            android:padding="11dp"
            android:text="안전 설정 · 회차 간격은 최소 2분 · 약 A/B는 현재 남은 개수보다 많이 예약할 수 없습니다."
            android:textColor="@color/warning"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1회차"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtOffset1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:text="분 후"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/edtDemoFood1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="65"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="4dp"
                        android:text="g"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtDemoPillA1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_blue"
                        android:gravity="center"
                        android:hint="약 A"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />

                    <EditText
                        android:id="@+id/edtDemoPillB1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_green"
                        android:gravity="center"
                        android:hint="약 B"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2회차"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtOffset2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="4"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:text="분 후"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/edtDemoFood2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="65"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="4dp"
                        android:text="g"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtDemoPillA2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_blue"
                        android:gravity="center"
                        android:hint="약 A"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />

                    <EditText
                        android:id="@+id/edtDemoPillB2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_green"
                        android:gravity="center"
                        android:hint="약 B"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3회차"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtOffset3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="7"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:text="분 후"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/edtDemoFood3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@color/primary"
                        android:gravity="center"
                        android:hint="65"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:paddingStart="4dp"
                        android:text="g"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtDemoPillA3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_blue"
                        android:gravity="center"
                        android:hint="약 A"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />

                    <EditText
                        android:id="@+id/edtDemoPillB3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_green"
                        android:gravity="center"
                        android:hint="약 B"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDemoCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="취소"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/surface"
                app:cornerRadius="14dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDemoStart"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.5"
                android:text="예약 저장 후 시작"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
